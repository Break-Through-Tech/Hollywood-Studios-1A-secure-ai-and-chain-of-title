# Copy to .env and fill in. Never commit .env.
FIRECRAWL_API_KEY=
# Vercel AI Gateway key (vercel.com > AI Gateway > API keys).
AI_GATEWAY_API_KEY=
# Optional: which model to use (default openai/gpt-4.1-mini, works on the free tier).
# Anthropic models such as anthropic/claude-haiku-5.5 need paid gateway credits.
# AGENT_MODEL=google/gemini-2.5-flash
