{
  "name": "hsi-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:auth": "node scripts/test-auth.mjs",
    "preview": "vite preview",
    "qa:routes": "node scripts/qa/routes.mjs",
