    "qa:interactions": "node scripts/qa/interactions.mjs",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test:api": "node scripts/test-api.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
